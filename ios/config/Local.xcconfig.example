// 本地开发配置示例
// 复制此文件到 /tmp/ios-local.xcconfig 并填入真实值

// 本地服务器地址（可按需修改）
API_BASE_URL = http://localhost:8100
// WS_BASE_URL 留空时会由 API_BASE_URL 自动推导为 ws://.../ws
WS_BASE_URL =

// 开发环境测试 Token
AUTH_TOKEN = dev_test_token_replace_with_real

// 如需使用局域网服务器（真机调试）
// API_BASE_URL = http://192.168.1.100:8100
// WS_BASE_URL = ws://192.168.1.100:8100/ws

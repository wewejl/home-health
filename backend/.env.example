# ============================================
# 灵犀健康 - 环境配置模板
# ============================================
# 复制此文件为 .env 或 .env.local 并填写实际配置
#
# 安全警告:
# - 生产环境必须更改所有默认密钥！
# - 使用强随机密钥（至少32位）
# - 不要将 .env 文件提交到版本控制

# --------------------------------------------
# 应用配置
# --------------------------------------------
APP_NAME=灵犀健康 API
APP_VERSION=1.0.0
DEBUG=true
SEED_DATA=true
PORT=8100

# --------------------------------------------
# 数据库配置
# --------------------------------------------
# Docker 内部网络使用 postgres:5432
# 本地开发可使用 localhost:5433 或 SQLite
# 生产环境必须更改数据库密码！
DATABASE_URL=postgresql+psycopg://postgres:YOUR_STRONG_PASSWORD@localhost:5433/home_health?options=-c%20timezone%3DUTC
# Docker 内部网络配置:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_STRONG_PASSWORD@postgres:5432/home_health?options=-c%20timezone%3DUTC
# SQLite 配置 (仅开发环境):
# DATABASE_URL=sqlite:///./app.db

# 数据库密码（docker-compose.yml 使用）
# 生产环境必须使用强密码！
# POSTGRES_PASSWORD=your-strong-password-here

# --------------------------------------------
# JWT 认证配置 (重要: 生产环境必须修改！)
# --------------------------------------------
# 生成强密钥命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_RANDOM_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------------------------
# Admin JWT 配置 (重要: 生产环境必须修改！)
# --------------------------------------------
# 生成强密钥命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_RANDOM_KEY
ADMIN_JWT_EXPIRE_HOURS=24

# --------------------------------------------
# 测试模式 (生产环境必须设置为 false)
# --------------------------------------------
# TEST_MODE: true 时验证码 000000 始终有效
TEST_MODE=false
# ADMIN_TEST_MODE: true 时跳过管理员/医生认证检查
ADMIN_TEST_MODE=false
# TEST_PHONES: 可以使用 000000 验证码的手机号（逗号分隔）
TEST_PHONES=18107300888

# --------------------------------------------
# CORS 配置
# --------------------------------------------
# 开发环境: 留空表示允许本地开发服务器
# 生产环境: 必须指定允许的域名（逗号分隔）
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=

# --------------------------------------------
# LLM 配置 (阿里云通义千问)
# --------------------------------------------
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-qwen-api-key
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1500

# Qwen-VL 多模态配置（皮肤科智能体使用）
# 可选模型: qwen3-vl-plus, qwen-vl-plus, qwen-vl-max
QWEN_VL_MODEL=qwen3-vl-plus

# --------------------------------------------
# LangGraph 配置
# --------------------------------------------
USE_LANGGRAPH=true
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1

# --------------------------------------------
# 语音转写配置 (阿里云 DashScope)
# --------------------------------------------
DASHSCOPE_API_KEY=your-dashscope-api-key
ASR_SAMPLE_RATE=16000

# --------------------------------------------
# 短信服务配置
# --------------------------------------------
SMS_PROVIDER=mock
# SMS_PROVIDER=aliyun  # aliyun/tencent/qiniu
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# --------------------------------------------
# 文件上传配置
# --------------------------------------------
MAX_UPLOAD_SIZE=52428800  # 50MB
UPLOAD_DIR=static/uploads/medical_files

# --------------------------------------------
# 监控和日志
# --------------------------------------------
LOG_LEVEL=DEBUG
